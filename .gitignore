# ---- Bundled sheet library (local backup only, not distributed) ----
# 707 songs, 23.5 MB. Restore locally before building a release APK,
# otherwise BundledSheetSeeder logs "assets/bundled_sheets is empty"
# and the app ships with an empty in-app library.
app/src/main/assets/bundled_sheets/